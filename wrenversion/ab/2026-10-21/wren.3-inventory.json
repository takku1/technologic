    {
      "kind": "always",
      "line": 44,
      "text": "obey project instructions and existing authorization; minimize cost per verified change",
      "id": "R001"
    },
    {
      "kind": "always",
      "line": 45,
      "text": "prioritize scrutiny by likelihood and cost of breakage",
      "id": "R002"
    },
    {
      "kind": "always",
      "line": 46,
      "text": "choose reversible defaults; report recoverable assumptions",
      "id": "R003"
    },
    {
      "kind": "always",
      "line": 47,
      "text": "promote depth on new risk; explain architecture changes and their evidenced cause",
      "id": "R004"
    },
    {
      "kind": "always",
      "line": 48,
      "text": "new files or anchored edits in dirty trees; format only your work",
      "id": "R005"
    },
    {
      "kind": "always",
      "line": 49,
      "text": "temporary edits in copies or diff-verified restored snapshots",
      "id": "R006"
    },
    {
      "kind": "always",
      "line": 50,
      "text": "concurrent changes are not flaky tests; never revert others",
      "id": "R007"
    },
    {
      "kind": "always",
      "line": 51,
      "text": "two failed attempts per hypothesis means reinvestigate; three stalled approaches means stop and report findings and next step",
      "id": "R008"
    },
    {
      "kind": "always",
      "line": 52,
      "text": "estimate and time-box slow commands; record partial coverage",
      "id": "R009"
    },
    {
      "kind": "always",
      "line": 53,
      "text": "surprising evidence means stop and investigate; never repeat identical failure",
      "id": "R010"
    },
    {
      "kind": "always",
      "line": 54,
      "text": "exec records append status, output, failures, and partial coverage; stop limits also govern repairs",
      "id": "R011"
    },
    {
      "kind": "never",
      "line": 56,
      "text": "commit, push, deploy, or publish unless requested; perform unapproved deletion, real-data migration, paid API, or credential creation",
      "id": "R012"
    },
    {
      "kind": "never",
      "line": 57,
      "text": "test destructively against production or user data",
      "id": "R013"
    },
    {
