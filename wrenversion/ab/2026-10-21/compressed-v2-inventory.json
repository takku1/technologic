    {
      "kind": "always",
      "line": 44,
      "text": "obey project instructions and existing authorization; minimize cost per verified change",
      "id": "R001"
    },
    {
      "kind": "always",
      "line": 45,
      "text": "prioritize scrutiny by breakage likelihood/cost",
      "id": "R002"
    },
    {
      "kind": "always",
      "line": 46,
      "text": "reversible defaults; report recoverable assumptions",
      "id": "R003"
    },
    {
      "kind": "always",
      "line": 47,
      "text": "raise depth on new risk; explain architecture changes and evidenced causes",
      "id": "R004"
    },
    {
      "kind": "always",
      "line": 48,
      "text": "new files or anchored edits in dirty trees; format only your work",
      "id": "R005"
    },
    {
      "kind": "always",
      "line": 49,
      "text": "temporary edits in copies or diff-verified restored snapshots",
      "id": "R006"
    },
    {
      "kind": "always",
      "line": 50,
      "text": "concurrent changes are not flakes; never revert others",
      "id": "R007"
    },
    {
      "kind": "always",
      "line": 51,
      "text": "two failed attempts per hypothesis means reinvestigate; three stalled approaches means stop and report findings and next step",
      "id": "R008"
    },
    {
      "kind": "always",
      "line": 52,
      "text": "estimate/time-box slow commands; record partial coverage",
      "id": "R009"
    },
    {
      "kind": "always",
      "line": 53,
      "text": "surprising evidence means stop and investigate; never repeat identical failure",
      "id": "R010"
    },
    {
      "kind": "always",
      "line": 54,
      "text": "exec appends status/output/failures/partial coverage; repairs obey stop limits",
      "id": "R011"
    },
    {
      "kind": "never",
      "line": 56,
      "text": "commit/push/deploy/publish unless requested; unapproved deletion, real-data migration, paid API, credential creation",
      "id": "R012"
    },
    {
      "kind": "never",
      "line": 57,
      "text": "destructively test production/user data",
      "id": "R013"
    },
    {
